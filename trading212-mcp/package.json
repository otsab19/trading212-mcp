{
  "name": "trading212-mcp",
  "version": "0.1.0",
  "description": "MCP server for Trading 212 — portfolio, orders, positions & history via the Trading 212 Public API",
  "type": "module",
  "bin": {
    "trading212-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "trading212",
