# Trading 212 API Configuration
# Generate your API key in the Trading 212 app: Settings → API (Beta)

TRADING212_API_KEY=your_api_key_here

# Environment: "demo" (paper trading) or "live" (real money)
# Default: demo — to prevent accidental live trades
TRADING212_ENV=demo

# Trading mode: set to "true" to enable order placement tools
# Default: false (read-only) — for safety
TRADING212_ALLOW_TRADING=false

# Transport mode: "stdio" or "http"
#   stdio — for Claude Desktop, Cursor, Antigravity IDE (default)
#   http  — for ChatGPT, Gemini, and remote MCP clients (exposes SSE endpoint)
TRADING212_TRANSPORT=stdio

# HTTP server port (only used when TRADING212_TRANSPORT=http)
PORT=3212
