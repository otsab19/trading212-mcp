{
  "name": "trading212-mcp",
  "version": "0.2.0",
  "description": "MCP server for Trading 212 — portfolio, orders, positions & history via the Trading 212 Public API. Supports stdio (Claude/Cursor) and HTTP/SSE (ChatGPT/Gemini).",
  "type": "module",
  "bin": {
    "trading212-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "TRADING212_TRANSPORT=http tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "TRADING212_TRANSPORT=http node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "trading212",
    "model-context-protocol",
    "ai",
    "trading",
    "stocks",
    "portfolio",
    "chatgpt",
    "gemini",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
